{
  "name": "wavelab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "demos/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "demo": "npm run demo --workspace=@tomerwave/autonomy-mastra --",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run harness:check && npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "godlint check",
    "lint:github": "godlint check --format github",
    "lint:json": "godlint check --format json",
    "harness:check": "godharness check && godharness doctor",
    "harness:context": "godharness context"
  },
  "license": "MIT",
  "devDependencies": {
    "@godharness/cli": "0.1.8",
    "@godlint/cli": "0.9.1"
  }
}
