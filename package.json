{
  "name": "wavelab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "demos/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "demo": "npm run demo --workspace=@tomerwave/autonomy-mastra --",
