{
  "name": "@tomerwave/vacation-chaos",
  "version": "1.0.0",
  "description": "Crowd-driven live agent demo: an agent books a vacation while the audience votes for chaos.",
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "tunnel": "cloudflared tunnel --no-autoupdate --url http://localhost:4545",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts src/**/*.test.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
