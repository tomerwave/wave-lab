# Set these in your shell. The CLI does not load this file.
# Optional: a local Chromium when Playwright's own download is not available.
CHROMIUM_PATH=
# Optional stage settings: show the browser and slow each action down.
HEADED=1
SLOW_MO_MS=600
# --chooser jev
TYPESAFE_API_KEY=
# --browser agentcore and --planner strands (AWS credentials come from your usual AWS profile or environment)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
